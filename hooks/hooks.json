{
  "description": "CLI Subagents: wake the main session when a subagent finishes or asks something (watched again after each subagent_message), and name uncollected results after resume or compaction.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/relay-inbox/**)",
            "command": "csa hook relay-write; exit 0",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "csa",
            "args": [
              "hook",
              "claude-sandbox"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_cli-subagents_cli-subagents__subagent_start|mcp__cli-subagents__subagent_start",
        "hooks": [
          {
            "type": "command",
            "command": "csa hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      },
      {
        "matcher": "mcp__plugin_cli-subagents_cli-subagents__subagent_message|mcp__cli-subagents__subagent_message",
        "hooks": [
          {
            "type": "command",
            "command": "csa hook await",
            "async": true,
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "csa hook pending",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "csa",
            "args": [
              "hook",
              "claude-sandbox-start"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "csa",
            "args": [
              "hook",
              "claude-sandbox-end"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
